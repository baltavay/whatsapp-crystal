# Designated WhatsApp group for send commands.
WHATSAPP_GROUP_JID=1234567890-1234567890@g.us

# Persistent linked-device session.
WHATSAPP_SESSION_DB=./whatsapp-session.db

# Native Crystal WebSocket transport.
WHATSAPP_WS_URL=wss://web.whatsapp.com/ws/chat

# Optional authenticated media override. If omitted, the native client sends
# the w:m media_conn IQ after connecting and uses the returned host/token.
WHATSAPP_MEDIA_HOST=
WHATSAPP_MEDIA_AUTH=
